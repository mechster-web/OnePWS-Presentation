# Copy to .env and fill in. .env is gitignored.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<cloud_name>
VITE_CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_ASSET_FOLDER=onepws-presentation

# ElevenLabs narration. Build-time only -- never expose with a VITE_ prefix.
ELEVENLABS_API_KEY=sk_<your_key>
ELEVENLABS_VOICE_ID=<voice_id_from_npm_run_voiceover:voices>
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
